# Copy to .env.local (gitignored). The RPC key is public in the browser — restrict it to the frontend domain at the provider.
VITE_SOLANA_CLUSTER=devnet
# NOT api.devnet.solana.com (429 rate limits at the venue)
VITE_SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=...
# Pacta program on devnet (pacta-anchor README); must match src/lib/solana/idl/pacta.json
VITE_PACTA_PROGRAM_ID=AgSfAvkXWBugaYg768AAZdpUT3oNYkx7JQGmZTrUwHWK
# Test USDC mint created by pacta-anchor scripts/demo-setup.ts — same as PACTA_USDC_MINT in the backend
VITE_USDC_MINT=6VLBMnVsHDDmg6a4tDqo9X4hMiCAZuuVDYJrivMVjvF9
VITE_API_URL=https://localhost:8443
VITE_MERCURE_URL=https://localhost:8443/.well-known/mercure
